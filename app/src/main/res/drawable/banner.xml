<?xml version="1.0" encoding="utf-8"?>
<!-- The dock tile: a deep blue glass gradient with a white play mark, after the tvOS TV app. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#FF0B1640" android:centerColor="#FF1F3FAF" android:endColor="#FF4C8DFF" />
        </shape>
    </item>
    <item android:drawable="@drawable/banner_play" />
</layer-list>
